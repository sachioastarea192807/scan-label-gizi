# ==========================================================
# Rahasia & konfigurasi lokal - JANGAN pernah di-commit
# ==========================================================
.env
*.env

# ==========================================================
# Python
# ==========================================================
__pycache__/
*.py[cod]
*.pyo
venv/
env/
.venv/

# ==========================================================
# Database lokal (kalau pakai SQLite)
# ==========================================================
*.db
*.sqlite
*.sqlite3

# ==========================================================
# File upload milik user (foto scan, foto profil, dsb.)
# Ini data hasil pemakaian aplikasi, bukan source code - tidak
# perlu ikut di-commit. Folder-nya sendiri tetap dipertahankan
# lewat .gitkeep supaya tidak error saat pertama kali clone.
# ==========================================================
static/uploads/original/*
static/uploads/preprocess/*
static/uploads/result/*
static/uploads/profile/*
!static/uploads/original/.gitkeep
!static/uploads/preprocess/.gitkeep
!static/uploads/result/.gitkeep
!static/uploads/profile/.gitkeep

# ==========================================================
# Editor & OS
# ==========================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
